#include <winres.h>
#include "resources.h"

IDI_APP ICON "../../assets/perfoverlay.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041004B0"
    BEGIN
      VALUE "ProductName", "PerfOverlay Supreme"
      VALUE "FileDescription", "PerfOverlay Supreme - monitor prestazioni in-game"
      VALUE "FileVersion", "1.1.0"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0410, 1200
  END
END
