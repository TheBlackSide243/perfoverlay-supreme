#include <winres.h>
#include "resources.h"

IDI_APP ICON "../../assets/perfoverlay.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PO_VERSION_MAJOR,PO_VERSION_MINOR,PO_VERSION_PATCH,0
 PRODUCTVERSION PO_VERSION_MAJOR,PO_VERSION_MINOR,PO_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041004B0"
    BEGIN
      VALUE "ProductName", "PerfOverlay Supreme"
      VALUE "FileDescription", "PerfOverlay Supreme - monitor prestazioni in-game"
      VALUE "FileVersion", PO_VERSION
      VALUE "ProductVersion", PO_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0410, 1200
  END
END
